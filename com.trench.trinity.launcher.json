{
  "id": "com.trench.trinity.launcher",
  "branch": "main",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "runtime-commit": "a0fd8b396dc57700e0f805b2114d3925aa4aa72b10aa7b53cce4ab23c5bc68ac",
  "sdk": "org.kde.Sdk",
  "sdk-commit": "60f08b6eb98851e85030a5d69566eecba7964e528e2128ea786bba59c415fb85",
  "base": "io.qt.qtwebengine.BaseApp",
  "base-version": "6.10",
  "base-commit": "dd4e9c5120bc85d02d5f68864dc838e3a17b73523bfe4e83b192f260b5d5133f",
  "command": "trinity",
  "modules": [
    {
      "name": "libevdev",
      "buildsystem": "autotools",
      "sources": [
        {
          "url": "https://www.freedesktop.org/software/libevdev/libevdev-1.13.1.tar.xz",
          "sha256": "06a77bf2ac5c993305882bc1641017f5bec1592d6d1b64787bad492ab34f2f36",
          "type": "archive"
        }
      ]
    },
    {
      "name": "libzip",
      "buildsystem": "cmake-ninja",
      "sources": [
        {
          "url": "https://github.com/nih-at/libzip.git",
          "commit": "dcd9a0bfe1ac2893d7f62bafb19f0a4d7b08c0f7",
          "type": "git"
        }
      ],
      "build-options": {
        "config-opts": [
          "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
        ]
      }
    },
    {
      "name": "pciutils",
      "buildsystem": "simple",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/pciutils/pciutils.git",
          "tag": "v3.14.0"
        }
      ],
      "build-commands": [
        "make -j$(nproc) ZLIB=no",
        "make install PREFIX=/app ZLIB=no"
      ]
    },
    {
      "name": "tapk-extract",
      "buildsystem": "simple",
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.com/javiercplus/tapk-extract.git",
          "branch": "main"
        },
        {
          "type": "archive",
          "only-arches": [
            "x86_64"
          ],
          "url": "https://ziglang.org/download/0.16.0/zig-x86_64-linux-0.16.0.tar.xz",
          "sha256": "70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00",
          "dest": "zig"
        },
        {
          "type": "archive",
          "only-arches": [
            "aarch64"
          ],
          "url": "https://ziglang.org/download/0.16.0/zig-aarch64-linux-0.16.0.tar.xz",
          "sha256": "ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17",
          "dest": "zig"
        }
      ],
      "build-commands": [
        "ZIG_LOCAL_CACHE_DIR=$PWD/.zig-local ZIG_GLOBAL_CACHE_DIR=$PWD/.zig-global ./zig/zig build --release=fast -Dtarget=native -Dcpu=baseline",
        "install -Dm755 zig-out/bin/tapk-extract /app/bin/mcpelauncher-extract"
      ]
    },
    {
      "name": "cpdirs",
      "buildsystem": "simple",
      "sources": [
        {
          "path": "files",
          "type": "dir"
        }
      ],
      "build-commands": [
        "mkdir -p /app/lib/i386-linux-gnu/GL",
        "cp -r . /app",
        "chmod +x /app/bin/mcpelauncher-client /app/bin/msa-daemon /app/bin/mcpelauncher-error || true"
      ]
    },
    {
      "name": "trinitylauncher-app",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "CFLAGS": "-msse3",
          "CXXFLAGS": "-msse3"
        }
      },
      "sources": [
        {
          "url": "https://github.com/Trinity-LA/Trinity-Launcher.git",
          "branch": "main",
          "type": "git"
        }
      ],
      "build-commands": [
        "cmake -G Ninja -DCMAKE_BUILD_TYPE=Release .",
        "ninja",
        "install -Dm755 app/trinity /app/bin/trinity"
      ]
    }
  ],
  "finish-args": [
    "--socket=fallback-x11",
    "--socket=wayland",
    "--share=network",
    "--socket=pulseaudio",
    "--device=all",
    "--device=dri",
    "--share=ipc",
    "--allow=multiarch",
    "--env=QTWEBENGINE_CHROMIUM_FLAGS=--no-sandbox --ignore-gpu-blocklist",
    "--env=ALSA_CONFIG_PATH=",
    "--env=QT_QUICK_CONTROLS_STYLE=",
    "--env=QT_QUICK_CONTROLS_HOVER_ENABLED=1",
    "--env=QML_IMPORT_PATH=/app/qml/",
    "--env=QML_DISABLE_DISK_CACHE=1",
    "--env=QT_QPA_PLATFORMTHEME=gtk3",
    "--env=SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt",
    "--env=SSL_CERT_DIR=/etc/ssl/certs",
    "--filesystem=xdg-documents",
    "--filesystem=xdg-pictures",
    "--filesystem=xdg-desktop",
    "--filesystem=xdg-download",
    "--filesystem=xdg-run/discord-ipc-0",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--talk-name=org.freedesktop.portal.OpenURI",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "source-date-epoch": 1775831785
}
