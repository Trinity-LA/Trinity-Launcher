# Maintainer: CasaDeIosel <soyjoelcastillo26@gmail.com>
pkgname=trinity-launcher-git
pkgver=r77.8890eff   # Se actualizará automáticamente con pkgver()
pkgrel=1
pkgdesc="Launcher gráfico para Minecraft Bedrock con Trinity UI, mcpelauncher y mcpe-extract"
arch=('x86_64')
url="https://github.com/Trinity-LA/Trinity-Launcher"
license=('BSD-3-Clause')
depends=(
    'qt6-base'
    'qt6-declarative'
    'qt6-webengine'
    'qt6-svg'
    'qt6-tools'
    'qt6-5compat'
    'curl'              # en lugar de libcurl
    'openssl'
    'alsa-lib'
    'libpulse'
    'jack2'             # en lugar de jack
    'pipewire'
    'mesa'
    'vulkan-icd-loader'
    'libx11'
    'libxi'
    'libxext'
    'libxfixes'
    'libxcursor'
    'libxrandr'
    'libxss'
    'libxtst'
    'libdrm'
    'systemd-libs'      # proporciona libudev
    'libusb'
    'dbus'
    'bluez'
    'libxkbcommon'
    'libpng'
    'libzip'
    'cups'
    'wayland'
    'libunwind'
    'libdecor'
    'hicolor-icon-theme'
)
makedepends=(
    'git'
    'cmake'
    'ninja'
    'clang'
    'qt6-base'
    'qt6-declarative'
    'qt6-webengine'
    'qt6-svg'
    'qt6-tools'
    'curl'
    'openssl'
    'alsa-lib'
    'libpulse'
    'jack2'
    'pipewire'
    'libx11'
    'libxi'
    'libxext'
    'libxfixes'
    'libxcursor'
    'libxrandr'
    'libxss'
    'libxtst'
    'mesa'
    'vulkan-headers'
    'vulkan-icd-loader'
    'libdrm'
    'systemd-libs'      # para libudev
    'libusb'
    'dbus'
    'bluez'
    'libxkbcommon'
    'libpng'
    'libzip'
    'cups'
    'wayland'
    'libunwind'
    'libdecor'
    'wget'
    'file'
    'python'
    'zsync'
)
provides=("${pkgname%-git}")
conflicts=("${pkgname%-git}")
source=(
    "git+https://github.com/Trinity-LA/Trinity-Launcher.git"
    "git+https://github.com/minecraft-linux/mcpelauncher-manifest.git#branch=qt6"
    "git+https://codeberg.org/javiercplus/mcpe-extract.git"
    "git+https://github.com/minecraft-linux/mcpelauncher-linux-bin.git"
)
md5sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

pkgver() {
    cd "$srcdir/Trinity-Launcher"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    # Renombrar directorios
    mv "$srcdir/Trinity-Launcher" "$srcdir/trinity"
    mv "$srcdir/mcpelauncher-manifest" "$srcdir/mcpelauncher"
    mv "$srcdir/mcpe-extract" "$srcdir/mcpe-extract"
    mv "$srcdir/mcpelauncher-linux-bin" "$srcdir/linux-bin"

    # Inicializar submódulos de mcpelauncher
    cd "$srcdir/mcpelauncher"
    git submodule update --init --recursive

    # Aplicar parche
    wget -O patch.sh https://huggingface.co/datasets/ccoffee20/trinity-installer/resolve/main/patch.sh
    bash patch.sh
}

build() {
    export CC=clang
    export CXX=clang++

    # Compilar mcpelauncher
    cd "$srcdir/mcpelauncher"
    mkdir -p build && cd build
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -G Ninja \
        -DBUILD_WEBVIEW=OFF \
        -DGAMEWINDOW_SYSTEM=SDL3 \
        -DBUILD_UI=OFF \
        -Wno-dev
    ninja -v

    # Compilar mcpe-extract
    cd "$srcdir/mcpe-extract"
    mkdir -p build && cd build
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -G Ninja \
        -Wno-dev
    ninja

    # Compilar Trinity
    cd "$srcdir/trinity"
    chmod +x build.sh
    ./build.sh --deps
    ./build.sh --release
}

package() {
    cd "$srcdir"

    install -d "$pkgdir/usr/bin"
    install -d "$pkgdir/usr/share/mcpelauncher"
    install -d "$pkgdir/usr/share/applications"
    install -d "$pkgdir/usr/share/icons/hicolor/scalable/apps"
    install -d "$pkgdir/usr/share/licenses/$pkgname"

    # Binarios de mcpelauncher y mcpe-extract
    install -Dm755 mcpelauncher/build/mcpelauncher-client/mcpelauncher-client "$pkgdir/usr/bin/mcpelauncher-client"
    install -Dm755 mcpe-extract/build/mcpelauncher-extract "$pkgdir/usr/bin/mcpelauncher-extract"
    find mcpelauncher/build -type f -name "msa-daemon" -exec install -Dm755 {} "$pkgdir/usr/bin/msa-daemon" \;
    find mcpelauncher/build -type f -name "mcpelauncher-error" -exec install -Dm755 {} "$pkgdir/usr/bin/mcpelauncher-error" \;

    # Binario de Trinity
    install -Dm755 trinity/build/app/trinity "$pkgdir/usr/bin/trinity"

    # Datos de mcpelauncher (linux-bin)
    cp -r linux-bin/* "$pkgdir/usr/share/mcpelauncher/"

    # Archivos .desktop e icono
    install -Dm644 trinity/resources/shortcuts/com.trench.trinity.launcher.desktop \
        "$pkgdir/usr/share/applications/com.trench.trinity.launcher.desktop"
    install -Dm644 trinity/resources/branding/com.trench.trinity.launcher.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.trench.trinity.launcher.svg"

    # Licencia
    install -Dm644 trinity/LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
